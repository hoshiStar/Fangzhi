{
  "name": "fangzhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "crawl": "node packages/core/src/cli.ts crawl",
    "build-index": "node packages/core/src/cli.ts build-index",
    "stats": "node packages/core/src/cli.ts stats",
    "search": "node packages/core/src/cli.ts search",
    "build:desktop": "npm run build --workspace @fangzhi/desktop",
    "package:desktop": "npm run package --workspace @fangzhi/desktop",
    "build:text-index": "node tools/build-text-index.ts",
    "build:mini": "node apps/miniprogram/build.mjs",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "test": "node --test tests/core.test.ts tests/download.test.ts tests/library.test.ts tests/fulltext.test.ts tests/text-index.test.ts tests/reader.test.ts",
    "verify": "npm run typecheck && npm run typecheck --workspace @fangzhi/desktop && npm test && node apps/miniprogram/smoke.cjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^24.0.0"
  }
}
