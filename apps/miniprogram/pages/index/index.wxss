.wrap { padding: 10px 12px 30px; }

.searchbar { display: flex; align-items: center; gap: 8px; }
.q {
  flex: 1; height: 38px; padding: 0 12px;
  background: #1b1e24; border: 1px solid #2c313a; border-radius: 8px;
  color: #e6e8ec; font-size: 14px;
}
.ph { color: #5b6472; }
.x { width: 30px; text-align: center; color: #9aa2af; }

.facets { white-space: nowrap; padding: 10px 0 4px; }
.gap { display: inline-block; width: 10px; }

.summary { padding: 6px 2px; font-size: 12px; color: #9aa2af; }

.book { padding: 10px 12px; margin-bottom: 8px; background: #1b1e24; border: 1px solid #2c313a; border-radius: 8px; }
.book .t { font-size: 15px; }
.book.fuzzy .t { color: #9aa2af; }
.book .m { margin-top: 3px; font-size: 12px; color: #9aa2af; }

.more { padding: 14px; text-align: center; font-size: 13px; color: #d8a24a; }
.more.dim { color: #5b6472; }
